root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows 脚本用 CRLF，否则 cmd / wscript 会解析失败
[*.{cmd,bat,vbs,ps1,reg}]
end_of_line = crlf
insert_final_newline = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.png]
insert_final_newline = false
